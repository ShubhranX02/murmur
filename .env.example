GOOGLE_CLIENT_ID=
# Optional for local frontend-only development. In deployed environments the
# client ID is supplied by the API using GOOGLE_CLIENT_ID above.
VITE_GOOGLE_CLIENT_ID=
# The public URL of the Express API deployed on Render. Set this in Vercel too.
VITE_API_URL=https://your-render-service.onrender.com

# Required production API secrets. Generate each with a cryptographically secure
# generator; both values must be different and never committed to source control.
# SESSION_JWT_SECRET: at least 32 random characters.
# YOUTUBE_TOKEN_ENCRYPTION_KEY: a base64-encoded 32-byte random key.
SESSION_JWT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Comma-separated exact frontend origins allowed to call the API. Do not use *.
CORS_ORIGINS=https://your-production-domain.com
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
FIREBASE_PROJECT_ID=
# Choose one Firebase Admin credential method for the Render backend:
# 1. Recommended: add the service-account JSON as a Render secret file and set
#    GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
# 2. Or paste the whole JSON object into this environment variable.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
PORT=3001
